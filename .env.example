UNLINK_ENGINE_URL=https://<base-sepolia-engine-url>
UNLINK_API_KEY=<your-unlink-api-key>
UNLINK_MNEMONIC="<your-12-or-24-word-mnemonic>"
UNLINK_RECIPIENT=unlink1<recipient-address>
UNLINK_TOKEN=0x<erc20-token-address-on-base-sepolia>
UNLINK_AMOUNT=<amount-in-smallest-unit>

# Optional polling overrides
UNLINK_POLL_INTERVAL_MS=<optional-poll-interval-ms>
UNLINK_POLL_TIMEOUT_MS=<optional-poll-timeout-ms>

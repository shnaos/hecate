{
  "manifest_version": 3,
  "name": "Hecate",
  "version": "0.1.0",
  "description": "Privacy-first smart wallet MVP Chrome extension.",
  "permissions": ["storage"],
  "host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/hecate-icon-16.png",
    "32": "icons/hecate-icon-32.png",
    "48": "icons/hecate-icon-48.png",
    "128": "icons/hecate-icon-128.png"
  },
  "action": {
    "default_title": "Hecate",
    "default_popup": "front/popup/popup.html",
    "default_icon": {
      "16": "icons/hecate-icon-16.png",
      "32": "icons/hecate-icon-32.png",
      "48": "icons/hecate-icon-48.png"
    }
  }
}
